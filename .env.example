# NOK TAMRA AUTO REELS Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=false
DASHBOARD_PIN=123456

# Database
# Default: SQLite file in storage, or PostgreSQL URL for production (Supabase/Neon/Render)
DATABASE_URL=sqlite+aiosqlite:///storage/nok_tamra.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Google Drive Automation
GDRIVE_FOLDER_ID=1HsnkGFR1wPvQXYVYLeaCaqo7q3BS6uxi
GDRIVE_CHECK_INTERVAL_MINUTES=15
# Optional: Path to Google Service Account JSON if running outside Antigravity environment
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta / Facebook Reels
# Graph API Version v21.0
META_API_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTO_PUBLISH=false

# AI Video Analysis & Caption Generator
# Supports Gemini 2.0 / 1.5 Flash (Recommended for Thai video analysis) or OpenAI
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Storage & Retention
MAX_STORAGE_MB=2048
AUTO_CLEANUP_AFTER_DAYS=3
